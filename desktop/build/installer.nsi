; ============================================================
;  GLM FPS Game - Windows installer (NSIS 3, MUI2)
;  Persian + English UI, per-user install, optional shortcuts
;  Built on Linux via portable makensis:  ./build.sh
; ============================================================

Unicode true
ManifestDPIAware true

!define APPNAME      "GLM FPS Game"
!define APPID        "GLMFPSGame"
!define EXENAME      "GLMFPSGame.exe"
!define APPVER       "1.0.0"
!define PUBLISHER    "aydinbarzegary1393-pixel"

Name "${APPNAME} ${APPVER}"
OutFile "../dist/GLM-FPS-Game-Setup-${APPVER}.exe"
InstallDir "$LOCALAPPDATA\Programs\GLMFPSGame"
RequestExecutionLevel user
SetCompressor /SOLID lzma
ShowInstDetails show
ShowUnInstDetails show

VIProductVersion "1.0.0.0"
VIAddVersionKey "ProductName" "${APPNAME} Setup"
VIAddVersionKey "CompanyName" "${PUBLISHER}"
VIAddVersionKey "FileDescription" "${APPNAME} installer"
VIAddVersionKey "FileVersion" "1.0.0.0"
VIAddVersionKey "ProductVersion" "${APPVER}"

!include "MUI2.nsh"
!include "nsDialogs.nsh"
!include "LogicLib.nsh"
!include "size.nsh"          ; generated by build.sh: !define ESTSIZE_KB <n>

!define MUI_ICON "../app/app-icon.ico"
!define MUI_UNICON "../app/app-icon.ico"
!define MUI_ABORTWARNING
!define MUI_FINISHPAGE_RUN "$INSTDIR\${EXENAME}"

; ---------- pages ----------
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
Page custom pgShortcuts pgShortcutsLeave
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "Farsi"
!insertmacro MUI_LANGUAGE "English"

; ---------- language strings (AFTER MUI_LANGUAGE: tables must exist) ----------
LangString TXT_SC_TITLE    ${LANG_ENGLISH} "Create Shortcuts"
LangString TXT_SC_SUB      ${LANG_ENGLISH} "Choose which shortcuts to create:"
LangString TXT_SC_DESKTOP  ${LANG_ENGLISH} "Desktop shortcut"
LangString TXT_SC_STARTMNU ${LANG_ENGLISH} "Start Menu shortcut"

LangString TXT_SC_TITLE    ${LANG_FARSI} "ساخت میان‌برها"
LangString TXT_SC_SUB      ${LANG_FARSI} "انتخاب کنید کدام میان‌برها ساخته شوند:"
LangString TXT_SC_DESKTOP  ${LANG_FARSI} "میان‌بر روی دسکتاپ"
LangString TXT_SC_STARTMNU ${LANG_FARSI} "میان‌بر در منوی استارت"

; ---------- vars ----------
Var hDesktopCB
Var hStartCB
Var bDesktop
Var bStartMenu

Function .onInit
  ReadRegStr $INSTDIR HKCU "Software\${APPID}" "InstallDir"
  !insertmacro MUI_LANGDLL_DISPLAY
FunctionEnd

Function pgShortcuts
  !insertmacro MUI_HEADER_TEXT "$(TXT_SC_TITLE)" "$(TXT_SC_SUB)"
  nsDialogs::Create 1018
  Pop $0
  ${If} $0 == error
    Abort
  ${EndIf}
  ${NSD_CreateCheckbox} 0u 24u 100% 13u "$(TXT_SC_DESKTOP)"
  Pop $hDesktopCB
  ${NSD_SetState} $hDesktopCB ${BST_CHECKED}
  ${NSD_CreateCheckbox} 0u 52u 100% 13u "$(TXT_SC_STARTMNU)"
  Pop $hStartCB
  ${NSD_SetState} $hStartCB ${BST_CHECKED}
  nsDialogs::Show
FunctionEnd

Function pgShortcutsLeave
  ${NSD_GetState} $hDesktopCB $bDesktop
  ${NSD_GetState} $hStartCB  $bStartMenu
FunctionEnd

; ---------- install ----------
Section ""
  SetOutPath "$INSTDIR"
  File /r "../staging/app-root/*"
  WriteUninstaller "$INSTDIR\Uninstall.exe"

  WriteRegStr HKCU "Software\${APPID}" "InstallDir" "$INSTDIR"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPID}" "DisplayName" "${APPNAME}"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPID}" "DisplayVersion" "${APPVER}"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPID}" "Publisher" "${PUBLISHER}"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPID}" "DisplayIcon" "$INSTDIR\resources\app\app-icon.ico"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPID}" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPID}" "QuietUninstallString" '"$INSTDIR\Uninstall.exe" /S'
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPID}" "NoModify" 1
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPID}" "NoRepair" 1
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPID}" "EstimatedSize" ${ESTSIZE_KB}

  ${If} $bDesktop == ${BST_CHECKED}
    CreateShortCut "$DESKTOP\${APPNAME}.lnk" "$INSTDIR\${EXENAME}" "" "$INSTDIR\resources\app\app-icon.ico" 0
  ${EndIf}
  ${If} $bStartMenu == ${BST_CHECKED}
    CreateDirectory "$SMPROGRAMS\${APPNAME}"
    CreateShortCut "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk" "$INSTDIR\${EXENAME}" "" "$INSTDIR\resources\app\app-icon.ico" 0
    CreateShortCut "$SMPROGRAMS\${APPNAME}\Uninstall ${APPNAME}.lnk" "$INSTDIR\Uninstall.exe"
  ${EndIf}
SectionEnd

; ---------- uninstall ----------
Section Uninstall
  Delete "$DESKTOP\${APPNAME}.lnk"
  Delete "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk"
  Delete "$SMPROGRAMS\${APPNAME}\Uninstall ${APPNAME}.lnk"
  RMDir  "$SMPROGRAMS\${APPNAME}"
  RMDir /r "$INSTDIR"
  DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPID}"
  DeleteRegKey HKCU "Software\${APPID}"
SectionEnd
